# Gemini を Vertex AI 経由で使う指定（必須）
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GCP プロジェクトID
GOOGLE_CLOUD_PROJECT=GCP プロジェクトID

# モデルを動かすリージョン（例: asia-northeast1 / global）
# 最新モデルが利用できるのはglobalのみ
GOOGLE_CLOUD_LOCATION=global
# 利用するモデル
AGENT_MODEL=gemini-3.6-flash

# Google OAuth認証を行うための情報（機密情報のため安全に管理すること）
GOOGLE_OAUTH_CLIENT_ID=クライアントID
GOOGLE_OAUTH_CLIENT_SECRET=クライアントシークレット
